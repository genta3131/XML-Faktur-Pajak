        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% XML Faktur Toolkit — arus aplikasi (v3)\n    A([\&quot;👤 User buka app/index.php\&quot;]) --&gt; B{\&quot;3 menu\&quot;}\n    B --&gt;|1. Cek baris bermasalah| C([\&quot;Upload XML + daftar nomor baris\&quot;])\n    C --&gt; D([\&quot;POST api.php → action=check_lines\&quot;])\n    D --&gt; E([\&quot;FakturLineResolver::buildIndex: indeks blok &lt;TaxInvoice&gt; per baris\&quot;])\n    E --&gt; F([\&quot;resolve: cocokkan baris error → invoice + RefDesc + tag terdekat\&quot;])\n    F --&gt; G([\&quot;Hasil tabel: baris, RefDesc, tag, isi baris, status\&quot;])\n    G --&gt; H([\&quot;Tampilkan di browser\&quot;])\n\n    B --&gt;|2. Cocokkan KTP / NPWP| I([\&quot;Upload XML + Excel master Sample NIK.xlsx\&quot;])\n    I --&gt; J([\&quot;POST api.php → action=match\&quot;])\n    J --&gt; K([\&quot;MasterReader::read: .xlsx via SimpleXLSX, .xls via PhpSpreadsheet\&quot;])\n    K --&gt; L([\&quot;Matcher::buildIndex: kunci cardCode|invoice\&quot;])\n    L --&gt; M([\&quot;matchRefDesc: NPWP → dokumen NPWP(+BuyerTin); KTP → National ID; kosong → diabaikan; tidak ada → not_found\&quot;])\n    M --&gt; N([\&quot;FakturReviser::apply: tulis BuyerDocument/BuyerDocumentNumber → XML revisi\&quot;])\n    N --&gt; O([\&quot;Simpan hasil ke app/tmp dengan token acak\&quot;])\n    O --&gt; P([\&quot;download.php: kirim file, hapus file tmp &gt; 1 jam\&quot;])\n\n    B --&gt;|3. XML → Excel| Q([\&quot;Upload XML\&quot;])\n    Q --&gt; R([\&quot;POST api.php → action=convert\&quot;])\n    R --&gt; S([\&quot;FakturExporter::export: baca XML, hitung total DPP/PPN/STLG\&quot;])\n    S --&gt; T([\&quot;Simpan .xlsx: sheet Ringkasan + Detail Barang\&quot;])\n    T --&gt; O\n\n    classDef ui fill:#e1f5fe,stroke:#01579b,stroke-width:2px;\n    classDef proc fill:#fff9c4,stroke:#fbc02d;\n    class A,B,H,P ui;\n    class C,D,E,F,G,I,J,K,L,M,N,Q,R,S,T proc;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="FdFaHl9EyvMLvsL0ddp4-1">
